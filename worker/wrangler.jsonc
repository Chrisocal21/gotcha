{
  "name": "gotcha-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gotcha",
      "database_id": "e030cfef-c5bd-43e7-af8e-e93369962f13",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ART", "bucket_name": "gotcha-art" }
  ],
  "vars": {
    "DAILY_CAP": "10",
    "VISION_MODEL": "gpt-4o",
    "IMAGE_MODEL": "gpt-image-1",
    "IMAGE_QUALITY": "low"
  }
}
